rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Helper to check if a user is an admin:
    // 1. Either exists in the "admins" collection
    // 2. Or has role == 'admin' or isAdmin == true in the "users" collection
    function isAdmin() {
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
          )
        )
      );
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if signedIn();

      // Creating a user document
      allow create: if isOwner(userId) &&
        !(request.resource.data.keys().hasAny(['suspended', 'suspendedAt', 'banType', 'banReason', 'banEvidence', 'suspendedUntil', 'warnings', 'role', 'isAdmin']));

      // Updating a user document
      allow update: if isAdmin() || (
        isOwner(userId) &&
        // Prevent owners from changing administrative/moderation fields on themselves
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended', 'suspendedAt', 'banType', 'banReason', 'banEvidence', 'suspendedUntil', 'warnings', 'role', 'isAdmin']))
      );

      allow delete: if isAdmin() || isOwner(userId);
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- GROUPS COLLECTION ---
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    // --- SESSIONS COLLECTION ---
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
    }

    // --- NOTES COLLECTION ---
    match /notes/{noteId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || resource.data.uploadedBy == request.auth.uid;
    }

    // --- REPORTS COLLECTION ---
    match /reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // --- CHATS COLLECTION ---
    match /chats/{chatRoomId} {
      allow read: if signedIn() && (
        resource == null ||
        chatRoomId.split('_').hasAny([request.auth.uid]) ||
        request.auth.uid in resource.data.participants
      );
      allow write: if signedIn();

      // Messages sub-collection
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    // --- CALLS COLLECTION ---
    match /calls/{callId} {
      allow read, write: if signedIn();

      // Candidates sub-collections
      match /callerCandidates/{candidateId} {
        allow read, write: if signedIn();
      }
      match /receiverCandidates/{candidateId} {
        allow read, write: if signedIn();
      }
    }

    // --- ADMIN LOGS COLLECTION ---
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
